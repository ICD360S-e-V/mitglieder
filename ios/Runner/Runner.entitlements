<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared container between the app and the Fernwartung broadcast upload
	     extension. The extension writes captured frames to a socket in this
	     group's container; the app (FlutterBroadcastScreenCapturer) reads them. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.de.icd360s.icd360sevMitglied</string>
	</array>
</dict>
</plist>
