<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Fernwartung (remote support) iOS screen capture via ReplayKit broadcast
	     upload extension. flutter_webrtc's FlutterBroadcastScreenCapturer reads
	     these to find the shared app-group container + the extension to launch. -->
	<key>RTCAppGroupIdentifier</key>
	<string>group.de.icd360s.icd360sevMitglied</string>
	<key>RTCScreenSharingExtension</key>
	<string>de.icd360s.icd360sevMitglied.Broadcast</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>MitgliederPortal - ICD360S e.V</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>icd360sev_mitglied</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Background Modes for WebSocket and notifications -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
		<string>voip</string>
	</array>
	<!-- Privacy - Camera Usage (Voice/Video Calls) -->
	<key>NSCameraUsageDescription</key>
	<string>Für Video-Anrufe mit dem Support-Team benötigt die App Zugriff auf Ihre Kamera.</string>
	<!-- Privacy - Microphone Usage (Voice Calls) -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Für Sprach- und Video-Anrufe mit dem Support-Team benötigt die App Zugriff auf Ihr Mikrofon.</string>
	<!-- Privacy - Photo Library Usage (Document Upload) -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Zum Hochladen von Dokumenten und Bildern benötigt die App Zugriff auf Ihre Fotomediathek.</string>
	<!-- Privacy - Photo Library Add Usage (Save Photos) -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Die App möchte Fotos in Ihrer Mediathek speichern.</string>
	<!-- Privacy - Location When In Use (WiFi name access for MITM detection) -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Nur zur Erkennung manipulierter WLAN-Netze. Die App liest den Namen des aktuell verbundenen WLANs, wenn ein TLS-Angriff erkannt wird. Kein Standort-Tracking.</string>
	<!-- url_launcher: schemes we probe with canLaunchUrl. iOS only allows
	     http/https/mailto by default; tel/sms must be declared here or
	     canLaunchUrl returns false and the "Sună-ne" / "Trimite SMS"
	     buttons on Claudiu's emergency sheet silently no-op. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tel</string>
		<string>sms</string>
		<string>mailto</string>
		<string>https</string>
		<string>whatsapp</string>
	</array>
</dict>
</plist>
