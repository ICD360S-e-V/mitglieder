flutter/ephemeral/

# Redistributable runtime installers fetched at build time (see the
# "Fetch Visual C++ redistributable" step in build-extras-platforms.yml).
# ~25 MB each - downloaded, never committed.
redist/

# Visual Studio user-specific files.
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio build-related files.
x64/
x86/

# Visual Studio cache files
# files ending in .cache can be ignored
*.[Cc]ache
# but keep track of directories ending in .cache
!*.[Cc]ache/
