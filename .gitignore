# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/
# If you're building an application, you may want to check-in your pubspec.lock
pubspec.lock

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# dotenv environment variables file
.env*

# Avoid committing generated Javascript files:
*.dart.js
# Produced by the --dump-info flag.
*.info.json
# When generated by dart2js. Don't specify *.js if your
# project includes source files written in JavaScript.
*.js
*.js_
*.js.deps
*.js.map

.flutter-plugins
.flutter-plugins-dependencies

# IDE
.idea/
*.iml
.DS_Store

# Kotlin build errors
.kotlin/

# Logs
*.log

# Backups
backups_*/

# Symbols (debug)
symbols/

# SSH keys - NEVER commit these
vps_*
*.pem
*.key
*.p12
*.jks
id_rsa
id_ed25519

# Project docs with sensitive info
CLAUDE.md

# Claude instructions (sensitive - server info, credentials)
CLAUDE.md

# SSH keys
vps_icd360sev_icd360s.de
vps_icd360sev_icd360s.de.pub

# Release keystore (signing)
release-keystore.jks
*.jks

# IDE settings (personal)
.vscode/
.claude/settings.local.json
devtools_options.yaml

# Local build scripts (CI/CD handles builds)
build_all_stores.sh

# Serverseitiger PHP-Code. Gepflegt wird er auf dem Server, nicht hier.
#
# Bis 17.09.2026 lag unter server/ eine Kopie davon im Repository. Sie war
# stumm veraltet: seal_signaturen.php und SignaturHelper.php wichen live vom
# eingecheckten Stand ab, und api/lib/RueckzugFenster.php aus PR #393 lag auf
# dem Produktionsserver ueberhaupt nicht. Wer aus dem Repository ausgerollt
# haette, haette damit den Siegel-Cron der beweisfuehrenden Unterschriften auf
# einen aelteren Stand zurueckgesetzt — ohne es zu merken. Eine Kopie, der man
# nicht ansieht, ob sie dem Server entspricht, ist schlimmer als keine.
server/

# Und zwar jede PHP-Datei, nicht nur die unter server/. Die Regel darueber
# haelt nur, solange serverseitiger Code auch dort liegt; ein Endpunkt, den
# jemand versehentlich woanders ablegt, waere sonst wieder im Repository.
# Stand 17.09.2026 ist keine einzige PHP-Datei ausserhalb von server/
# eingecheckt, die Regel nimmt also nichts weg.
*.php
