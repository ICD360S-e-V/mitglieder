# Enforce LF line endings repo-wide; let Git auto-detect text files.
* text=auto eol=lf

# Windows-only scripts must keep CRLF or cmd.exe refuses them.
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary assets — never touch.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.icns      binary
*.webp      binary
*.pdf       binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.eot       binary
*.mp3       binary
*.mp4       binary
*.wav       binary
*.zip       binary
*.gz        binary
*.jar       binary
*.keystore  binary
*.jks       binary
